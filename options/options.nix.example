{
  # Host Configuration
  # -----------------
  # hostname: The machine's network name
  # domain: Local domain suffix (FQDN will be hostname.domain)
  hostname = "homeserver";
  domain = "home";

  # Locale & Time
  # -------------
  # timeZone: Timezone for the system (e.g., "Europe/London", "America/New_York")
  # locale: System locale for language/formatting
  # keyMap: Console keyboard layout
  # phoneRegion: ISO country code for phone number formatting (used by Nextcloud)
  timeZone = "Europe/London";
  locale = "en_GB.UTF-8";
  keyMap = "uk";
  phoneRegion = "GB";

  # Network
  # -------
  # interface: Network interface name (find with: ip link show)
  # ipAddress: Static IP address for the server
  # prefixLength: Network prefix (24 = 255.255.255.0)
  # gateway: Default gateway/router IP
  # nameservers: DNS servers (127.0.0.1 uses local AdGuard Home)
  interface = "enp3s0";
  ipAddress = "192.168.0.66";
  prefixLength = 24;
  gateway = "192.168.0.1";
  nameservers = [ "127.0.0.1" "1.1.1.1" "9.9.9.9" ];

  # SSH
  # ---
  # sshPort: SSH server port (non-standard recommended for security)
  # sshKeys: Public keys authorized for SSH login
  sshPort = 2266;
  sshKeys = [
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your-key-comment"
  ];

  # Admin User
  # ----------
  # adminUser: Username for the administrator account
  adminUser = "admin";

  # Services - Nextcloud
  # -------------------
  # nextcloudDomain: Domain for Nextcloud (resolved via AdGuard rewrite)
  # nextcloudDataDir: Directory for Nextcloud data storage
  # nextcloudMaxUpload: Maximum file upload size
  # nextcloudPort: Internal port (Caddy proxies HTTPS to this)
  nextcloudDomain = "cloud.home";
  nextcloudDataDir = "/srv/data/nextcloud";
  nextcloudMaxUpload = "16G";
  nextcloudPort = 8080;

  # Services - AdGuard / DNS
  # -----------------------
  # adguardPort: AdGuard Home web interface port
  # dnsPort: DNS server port (53 is standard)
  # dnsDomain: Domain for AdGuard admin interface
  # upstreamDns: Upstream DNS servers (DNS-over-HTTPS for privacy)
  # bootstrapDns: Plain DNS servers for resolving DoH hostnames
  adguardPort = 3000;
  dnsPort = 53;
  dnsDomain = "dns.home";
  upstreamDns = [
    "https://dns.cloudflare.com/dns-query"
    "https://dns.quad9.net/dns-query"
  ];
  bootstrapDns = [ "1.1.1.1" "9.9.9.9" ];

  # Fail2ban
  # --------
  # fail2banMaxRetry: Failed attempts before banning
  # fail2banBantime: Initial ban duration (escalates on repeat offenses)
  fail2banMaxRetry = 5;
  fail2banBantime = "1h";

  # Disks
  # -----
  # osDisk: Disk device for the operating system (WILL BE FORMATTED!)
  # dataDisk: Partition for data storage (must be pre-formatted)
  # dataMount: Mount point for the data partition
  osDisk = "/dev/nvme0n1";
  dataDisk = "/dev/sda1";
  dataMount = "/srv/data";
}
